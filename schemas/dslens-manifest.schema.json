{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jcempro/DSLens/schemas/dslens-manifest.schema.json",
  "$comment": "Origem: https://github.com/jcempro/DSLens; autor: JeanCarloEM; licença: MPL-2.0 https://mozilla.org/MPL/2.0/; schema declarativo, edição manual permitida somente com sincronização do RCF.",
  "title": "DSLens Public Contract Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "contractVersion", "implementations", "capabilities", "publicSurface", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "license"],
      "properties": {
        "name": { "const": "DSLens" },
        "repository": { "type": "string", "format": "uri" },
        "license": { "const": "MPL-2.0" }
      }
    },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "implementations": {
      "type": "array",
      "items": { "$ref": "#/$defs/implementation" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "publicSurface": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$" },
    "status": { "enum": ["required", "supported", "optional", "experimental", "unavailable", "environment-incompatible"] },
    "stability": { "enum": ["stable", "experimental", "deprecated", "internal"] },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "runtime", "version", "status", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "language": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "normativeReference"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "normativeReference": { "type": "string", "minLength": 1 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "language", "runtime", "signature", "synchronism", "stability", "import", "normativeReference"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "enum": ["variable", "constant", "enum", "object", "class", "interface", "type", "method", "function", "component", "hook", "adapter", "event", "configuration", "module", "subpath", "command", "build", "binding", "schema"] },
        "language": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "parameters": { "type": "array", "items": { "type": "string" } },
        "returns": { "type": "string" },
        "effects": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "synchronism": { "enum": ["sync", "async", "both", "n/a"] },
        "stability": { "$ref": "#/$defs/stability" },
        "import": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "compatibility": { "type": "array", "items": { "type": "string" } },
        "extension": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "deprecatedSince": { "type": "string" },
        "normativeReference": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "implementation", "consumer", "runtime", "format", "entryPoint", "stability"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "implementation": { "$ref": "#/$defs/id" },
        "consumer": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "entryPoint": { "type": "string", "minLength": 1 },
        "types": { "type": ["string", "null"] },
        "externalDependencies": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "minified": { "type": "boolean" },
        "sourceMap": { "type": "boolean" },
        "stability": { "$ref": "#/$defs/stability" },
        "budgetBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
