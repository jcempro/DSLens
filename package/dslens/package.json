{
  "name": "@jeancarloem/dslens",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "author": "JeanCarloEM (https://jeancarloem.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcempro/DSLens.git"
  },
  "homepage": "https://DSLens.jcemp.pro",
  "bugs": "https://github.com/jcempro/DSLens/issues",
  "description": "Cross-language library for declaratively resolving dynamic endpoints and values through a navigation DSL over structured remote data.",
  "main": "README.md",
  "type": "module",
  "types": "./dist/typescript/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "ai",
    "architecture",
    "context",
    "dsl",
    "validation"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "browser": {
        "import": "./dist/javascript/browser.js",
        "require": "./dist/commonjs/browser.cjs"
      },
      "worker": {
        "import": "./dist/javascript/worker.js",
        "require": "./dist/commonjs/worker.cjs"
      },
      "node": {
        "import": "./dist/javascript/server.js",
        "require": "./dist/commonjs/server.cjs"
      },
      "import": "./dist/javascript/index.js",
      "require": "./dist/commonjs/index.cjs",
      "default": "./dist/javascript/index.js"
    },
    "./browser": {
      "types": "./dist/typescript/browser.d.ts",
      "import": "./dist/javascript/browser.js",
      "require": "./dist/commonjs/browser.cjs",
      "default": "./dist/javascript/browser.js"
    },
    "./worker": {
      "types": "./dist/typescript/worker.d.ts",
      "import": "./dist/javascript/worker.js",
      "require": "./dist/commonjs/worker.cjs",
      "default": "./dist/javascript/worker.js"
    },
    "./server": {
      "types": "./dist/typescript/server.d.ts",
      "import": "./dist/javascript/server.js",
      "require": "./dist/commonjs/server.cjs",
      "default": "./dist/javascript/server.js"
    },
    "./components/detect": {
      "types": "./dist/typescript/components/detect.d.ts",
      "import": "./dist/javascript/components/detect.js",
      "require": "./dist/commonjs/components/detect.cjs",
      "default": "./dist/javascript/components/detect.js"
    },
    "./components/resolve-data": {
      "types": "./dist/typescript/components/resolve-data.d.ts",
      "import": "./dist/javascript/components/resolve-data.js",
      "require": "./dist/commonjs/components/resolve-data.cjs",
      "default": "./dist/javascript/components/resolve-data.js"
    },
    "./components/resolve-source": {
      "types": "./dist/typescript/components/resolve-source.d.ts",
      "import": "./dist/javascript/components/resolve-source.js",
      "require": "./dist/commonjs/components/resolve-source.cjs",
      "default": "./dist/javascript/components/resolve-source.js"
    },
    "./browser/components/detect": {
      "types": "./dist/typescript/browser/components/detect.d.ts",
      "import": "./dist/javascript/browser/components/detect.js",
      "require": "./dist/commonjs/browser/components/detect.cjs",
      "default": "./dist/javascript/browser/components/detect.js"
    },
    "./browser/components/resolve-data": {
      "types": "./dist/typescript/browser/components/resolve-data.d.ts",
      "import": "./dist/javascript/browser/components/resolve-data.js",
      "require": "./dist/commonjs/browser/components/resolve-data.cjs",
      "default": "./dist/javascript/browser/components/resolve-data.js"
    },
    "./browser/components/resolve-source": {
      "types": "./dist/typescript/browser/components/resolve-source.d.ts",
      "import": "./dist/javascript/browser/components/resolve-source.js",
      "require": "./dist/commonjs/browser/components/resolve-source.cjs",
      "default": "./dist/javascript/browser/components/resolve-source.js"
    },
    "./typescript": "./src/index.ts",
    "./manifest": "./dist/manifest.json",
    "./manifests/components": "./dist/manifests/components/index.json",
    "./manifests/components/detect": "./dist/manifests/components/detect.json",
    "./manifests/components/resolve-data": "./dist/manifests/components/resolve-data.json",
    "./manifests/components/resolve-source": "./dist/manifests/components/resolve-source.json",
    "./build-target": "./dist/build-target.json"
  }
}
