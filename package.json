  "homepage": "https://DSLens.jcemp.pro",
  "bugs": "https://github.com/jcempro/DSLens/issues",
  "description": "Cross-language library for declaratively resolving dynamic endpoints and values through a navigation DSL over structured remote data.",
  "main": "README.md",
  "type": "commonjs",
  "types": "./package/dslens/dist/typescript/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "ai",
    "architecture",
    "context",
    "dsl",
    "validation"
  ],
  "files": [
    "package/dslens"
  ],
  "exports": {
    ".": {
      "types": "./package/dslens/dist/typescript/index.d.ts",
      "browser": {
        "import": "./package/dslens/dist/javascript/browser.js",
        "require": "./package/dslens/dist/commonjs/browser.cjs"
      },
      "worker": {
        "import": "./package/dslens/dist/javascript/worker.js",
        "require": "./package/dslens/dist/commonjs/worker.cjs"
      },
      "node": {
        "import": "./package/dslens/dist/javascript/server.js",
        "require": "./package/dslens/dist/commonjs/server.cjs"
      },
      "import": "./package/dslens/dist/javascript/index.js",
      "require": "./package/dslens/dist/commonjs/index.cjs",
      "default": "./package/dslens/dist/javascript/index.js"
    },
    "./browser": {
      "types": "./package/dslens/dist/typescript/browser.d.ts",
      "import": "./package/dslens/dist/javascript/browser.js",
      "require": "./package/dslens/dist/commonjs/browser.cjs"
    },
    "./worker": {
      "types": "./package/dslens/dist/typescript/worker.d.ts",
      "import": "./package/dslens/dist/javascript/worker.js",
      "require": "./package/dslens/dist/commonjs/worker.cjs"
    },
    "./server": {
      "types": "./package/dslens/dist/typescript/server.d.ts",
      "import": "./package/dslens/dist/javascript/server.js",
      "require": "./package/dslens/dist/commonjs/server.cjs"
    },
    "./typescript": "./src/ts/index.ts",
    "./manifest": "./manifests/dslens.json",
    "./build-target": "./package/dslens/dist/build-target.json"
  },
